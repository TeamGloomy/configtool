<%  for (let i = 0; i < model.sensors.accelerometers.length; i++) {
        const accelerometer = model.sensors.accelerometers[i];
        if (accelerometer !== null) {
            const canAddress = model.getAccelerometerBoard(accelerometer); -%>
M955 <%- params({
    P: i,
    C: model.getAccelerometerPort(canAddress) ?? undefined,
    I: accelerometer.orientation
}) %> ; configure accelerometer #<%- i %> on board #<%- canAddress %>
<%      }
    } %>
<%  // STM32 mainboard external accelerometer (configured via the SPI section; numbered after any Duet-style accelerometers)
    if (isSTM32BoardType(model.boardType) && model.configTool.stm32AccelSpiChannel >= 0 && model.configTool.stm32AccelCsPin) { -%>
M955 P<%- model.sensors.accelerometers.length %> C"<%- model.configTool.stm32AccelCsPin %><%- model.configTool.stm32AccelIntPin ? '+' + model.configTool.stm32AccelIntPin : '' %>" I<%- model.configTool.stm32AccelOrientation %> ; configure external accelerometer on STM32 mainboard
<%  } %>
