<%
const ct = model.configTool;
const boardTxtDefaults = model.boardDefinition?.boardTxtContent ?? "";

// Read a single key's default value from the firmware's baked-in rrfboot.txt defaults.
// Returns the value with braces/spaces stripped (e.g. "D.9,D.8"), or null if not present.
function rrfbootValue(key) {
    const prefix = key + "=";
    for (const line of boardTxtDefaults.split("\n")) {
        const t = line.trim();
        if (t.startsWith(prefix)) {
            return t.substring(prefix.length).replace(/[{}\s]/g, "");
        }
    }
    return null;
}
// Treat empty / NoPin,NoPin / missing as equivalent "unset" so we don't emit redundant lines.
function pinsUnset(v) { return !v || v.replace(/\s/g, "").toLowerCase() === "nopin,nopin"; }
function normPins(v) { return (v || "").replace(/[{}\s]/g, ""); }
-%>
; board.txt — generated by the RepRapFirmware Configuration Tool
; Only settings that differ from the firmware's built-in defaults are listed here.
<%
// Serial port overrides — only when the selection differs from the default.
// The firmware hardcodes serial.aux to A.10,A.9 unless rrfboot.txt overrides it,
// which is why most boards don't list serial.aux in rrfboot.txt.
const auxRrfboot = rrfbootValue("serial.aux.rxTxPins");
const auxDefault = (auxRrfboot === null) ? "A.10,A.9" : (pinsUnset(auxRrfboot) ? "" : auxRrfboot);
const auxUser = pinsUnset(ct.stm32AuxSerial) ? "" : normPins(ct.stm32AuxSerial);
if (auxUser !== auxDefault) {
%>
serial.aux.rxTxPins={<%- auxUser || "NoPin,NoPin" %>}
<% }
const aux2Default = pinsUnset(rrfbootValue("serial.aux2.rxTxPins")) ? "" : rrfbootValue("serial.aux2.rxTxPins");
const aux2User = pinsUnset(ct.stm32Aux2Serial) ? "" : normPins(ct.stm32Aux2Serial);
if (aux2User !== aux2Default) {
%>
serial.aux2.rxTxPins={<%- aux2User || "NoPin,NoPin" %>}
<% }

// WiFi pin overrides — only written when value differs from the board's hardware default
const wifiDef = model.boardDefinition?.wifiConfig;
if (wifiDef) {
    if (ct.stm32WifiEspDataReadyPin && ct.stm32WifiEspDataReadyPin !== wifiDef.espDataReadyPin) {
%>
wifi.espDataReadyPin=<%- ct.stm32WifiEspDataReadyPin %>
<%  }
    if (ct.stm32WifiTfrReadyPin && ct.stm32WifiTfrReadyPin !== wifiDef.tfrReadyPin) {
%>
wifi.TfrReadyPin=<%- ct.stm32WifiTfrReadyPin %>
<%  }
    if (ct.stm32WifiEspResetPin && ct.stm32WifiEspResetPin !== wifiDef.espResetPin) {
%>
wifi.espResetPin=<%- ct.stm32WifiEspResetPin %>
<%  }
    if ((ct.stm32WifiSerialRxPin || ct.stm32WifiSerialTxPin) &&
        (ct.stm32WifiSerialRxPin !== wifiDef.serialRxPin || ct.stm32WifiSerialTxPin !== wifiDef.serialTxPin)) {
%>
wifi.serialRxTxPins={<%- ct.stm32WifiSerialRxPin %>, <%- ct.stm32WifiSerialTxPin %>}
<%  }
    if (ct.stm32WifiModuleType && ct.stm32WifiModuleType !== (wifiDef.moduleType ?? "esp32")) {
%>
wifi.moduleType=<%- ct.stm32WifiModuleType %>
<%  }
}

// SPI channel pin overrides — only written when user changed from rrfboot defaults
const spiChValues = [
    ct.stm32SpiCh0, ct.stm32SpiCh1, ct.stm32SpiCh2,
    ct.stm32SpiCh3, ct.stm32SpiCh4, ct.stm32SpiCh5,
    ct.stm32SpiCh6, ct.stm32SpiCh7, ct.stm32SpiCh8,
];
for (let i = 0; i < 9; i++) {
    if (spiChValues[i]) {
%>
SPI<%- i %>.pins={<%- spiChValues[i] %>}
<%  }
}

// Accelerometer SPI channel (no rrfboot default exists, so always an override when set)
if (ct.stm32AccelSpiChannel >= 0) {
%>
accelerometer.spiChannel=<%- ct.stm32AccelSpiChannel %>
<% }

// Driver type overrides — only written when any slot has a non-default type
// builtInDrivers boards have fixed driver types; no override needed
const _driverTypes = ct.stm32DriverTypes ? ct.stm32DriverTypes.split(',') : [];
const _hasCustomDriverType = _driverTypes.some(t => t && t !== 'tmcauto');
if (_hasCustomDriverType && !model.boardDefinition?.builtInDrivers) {
    const _typeList = _driverTypes.map(t => {
        if (!t || t === 'tmcauto') return 'tmcauto';
        if (t === 'external5160') return 'tmc5160';   // external 5160 = tmc5160 in board.txt
        return t;
    }).join(',');
%>
stepper.DriverType={<%- _typeList %>}
<% }

// SPI temperature sensor (BME280 / MAX317xx) CS pins — collected from the configured sensors
const _spiSensorTypes = [
    AnalogSensorType.bme280, AnalogSensorType.max31855,
    AnalogSensorType.max31856, AnalogSensorType.max31865
];
const _csPins = [];
for (let i = 0; i < model.sensors.analog.length; i++) {
    const _s = model.sensors.analog[i], _cs = model.configTool.sensors[i];
    if (_s && _spiSensorTypes.includes(_s.type) && _cs && _cs.stm32Pin) {
        _csPins.push(_cs.stm32Pin);
    }
}
if (_csPins.length > 0) {
    if (ct.stm32SpiTempChannel >= 0) {
%>
heat.spiTempSensorChannel=<%- ct.stm32SpiTempChannel %>
<%  }
%>
heat.spiTempSensorCSPins={<%- _csPins.join(',') %>}
<% }

// Sensorless homing DIAG pins. Only UART drivers (TMC2208/2209/2225/2226) use the DIAG pin —
// TMC2240/5160 do stall detection over SPI and need no diag pin. Emit stepper.TmcDiagPins
// listing the diag pin for each mainboard driver that (a) has sensorless enabled (StallGuard
// threshold set) AND (b) is a UART driver type, NoPin for the rest. The diag pin shares the
// endstop connector, so a configured driver's endstop input is unavailable.
const _diagPins = model.boardDefinition?.diagPins;
if (_diagPins && _diagPins.length > 0) {
    // Per-slot driver type (empty / "tmcauto" = auto-detect, treated as a possible UART driver).
    const _types = ct.stm32DriverTypes ? ct.stm32DriverTypes.split(',') : [];
    const _spiDriver = (t) => t === 'tmc5160' || t === 'external5160' || t === 'tmc2240';
    // Which mainboard (board 0) drivers have sensorless enabled on a non-SPI (UART) driver?
    const _sensorless = new Set();
    for (const d of model.configTool.drivers) {
        if (!d.id.board && d.sgThreshold !== 0 && !_spiDriver(_types[d.id.driver])) {
            _sensorless.add(d.id.driver);
        }
    }
    if (_sensorless.size > 0) {
        const _list = _diagPins.map((pin, i) => _sensorless.has(i) ? pin : "NoPin").join(",");
%>
stepper.TmcDiagPins={<%- _list %>}
<%  }
}

// 12864 display (RepRapDiscount Full Graphic) on EXP3 / SPI channel 5. Pins are fixed named
// aliases on the EXP headers and identical across boards, so the lcd.* config is constant.
if (model.boardDefinition?.supports12864 && ct.stm32Display12864) {
%>
lcd.encoderPinA=BTN_EN2
lcd.encoderPinB=BTN_EN1
lcd.encoderPinSw=BTN_ENC
lcd.lcdCSPin=LCD_RS
lcd.spiChannel=5
<% } %>
